# Local development needs only AUTH_SECRET (openssl rand -base64 32) and FINNY_DEV_LOGIN=1.
AUTH_SECRET=
FINNY_DEV_LOGIN=1
# Who may sign in (comma-separated). Required in production.
FINNY_ALLOWED_EMAILS=
# Google sign-in (production): from Google Cloud Console › Credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Postgres (production: Neon via Vercel Storage). Empty = embedded PGlite in .data/pglite.
DATABASE_URL=
