{
  "name": "finny",
  "version": "0.23.0",
  "private": true,
  "description": "Finny: one personal financial record dashboard, replacing two money workbooks.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test --experimental-strip-types --no-warnings tests/unit/*.test.mts",
    "test:migration": "node --experimental-strip-types --no-warnings tests/migration.test.mts",
    "test:e2e": "node tests/e2e/run.cjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@electric-sql/pglite": "0.5.16",
    "@fontsource-variable/nunito": "5.3.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "write-excel-file": "4.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
